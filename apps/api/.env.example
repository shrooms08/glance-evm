# Glance API. Copy to apps/api/.env; `pnpm --filter api dev` loads it. Every variable is optional.

# --- Chain -------------------------------------------------------------------------------------------------------------
# JSON-RPC endpoint. Must serve the chain in DEPLOYMENT_FILE.
RPC_URL=https://rpc.testnet.chain.robinhood.com
# Deployment record written by `make deploy-robinhood`. All addresses come from here. Defaults to ../../deployments/46630.json.
# DEPLOYMENT_FILE=/absolute/path/to/deployments/46630.json
EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
# Vault used when a request names none (GET /price, /health's feed states). Defaults to the deployment's primary vault:
# the demo vault on real Paxos USDG. The TestUSDG fallback vault is 0xacfE90d34Bb56222Af06904A7547b6a9aC9AEe2D.
DEFAULT_VAULT=0xCafa07acA6c8B3efbF4638Fd49E7beB42a0D0113

# --- Agent key ---------------------------------------------------------------------------------------------------------
# The agent's hot key, used only by POST /trade. Without it every other endpoint works and /trade returns 503.
# It is bounded on chain by the vault (see src/signer.ts), never logged and never returned. Testnet key only.
AGENT_PRIVATE_KEY=

# --- Optional LLM fallback for /resolve --------------------------------------------------------------------------------
# Used only when the dictionary finds nothing. The resolver works fully without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- HTTP --------------------------------------------------------------------------------------------------------------
PORT=8790
# development allows http://localhost:* origins; production allows only CORS_ORIGINS.
NODE_ENV=development
# Comma separated, e.g. chrome-extension://abcdefghijklmnopabcdefghijklmnop,https://console.example.com
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=120
TRADE_RATE_LIMIT_PER_MINUTE=10
# Only set true behind a proxy you control, or clients can spoof their IP for rate limiting.
TRUST_PROXY=false
# How far back /vault/:address/activity scans (blocks are ~0.17s; 2,000,000 is about 4 days).
ACTIVITY_LOOKBACK_BLOCKS=2000000
