# Glance API. Copy to apps/api/.env; `pnpm --filter api dev` loads it. Every variable is optional.

# --- Chain -------------------------------------------------------------------------------------------------------------
# JSON-RPC endpoint, tried first. Must serve the chain in DEPLOYMENT_FILE. A dedicated endpoint (for example your QuickNode
# endpoint URL) is steadier than the public one. Its token is redacted in logs.
RPC_URL=https://rpc.testnet.chain.robinhood.com
# Comma-separated endpoints tried in order when RPC_URL fails or times out. Defaults to the public testnet RPC, so a
# dedicated RPC_URL still falls back to it. Leave empty for no fallback.
# RPC_FALLBACK_URLS=https://rpc.testnet.chain.robinhood.com
# Deployment record written by `make deploy-robinhood`. All addresses come from here. Defaults to ../../deployments/46630.json.
# DEPLOYMENT_FILE=/absolute/path/to/deployments/46630.json
EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
# Vault used when a request names none (GET /price, /health's feed states). Defaults to the deployment's primary vault:
# the demo vault on real Paxos USDG. The TestUSDG fallback vault is 0xacfE90d34Bb56222Af06904A7547b6a9aC9AEe2D.
DEFAULT_VAULT=0xCafa07acA6c8B3efbF4638Fd49E7beB42a0D0113

# --- Agent key ---------------------------------------------------------------------------------------------------------
# The agent's hot key, used only by POST /trade. Without it every other endpoint works and /trade returns 503.
# It is bounded on chain by the vault (see src/signer.ts), never logged and never returned. Testnet key only.
AGENT_PRIVATE_KEY=

# --- Optional LLM fallback for /resolve --------------------------------------------------------------------------------
# Used only when the dictionary finds nothing. The resolver works fully without it.
ANTHROPIC_API_KEY=
# Claude models: Haiku by default for every call. A model name containing "opus" is refused at startup (one warning,
# Haiku used instead) unless ALLOW_OPUS=1. ANTHROPIC_MODEL is the older name for RESOLVER_MODEL and still works.
RESOLVER_MODEL=claude-haiku-4-5
# ALLOW_OPUS=1
# Claude calls allowed per UTC day across the whole API (every purpose). At the limit, and for an hour after
# an Anthropic 401/402/429 or "credit balance" error, the dictionary resolver and the rules intent parser answer.
LLM_DAILY_CALL_LIMIT=250
# Daily budgets per purpose, under the total. When one runs out only that purpose falls back: the resolver to the
# dictionary, intent to the rules, why to headlines only. OTHER is reserved for upcoming features ("Show me").
LLM_BUDGET_RESOLVER=40
LLM_BUDGET_INTENT=80
LLM_BUDGET_WHY=60
LLM_BUDGET_OTHER=70
# Company lookups (one Claude call per glance, never on a passive page load) are cached 7 days per candidate name,
# "not listed" included (keys are hashes). The call counters sit next to it (llm-usage.json), and the portfolio's
# event cache in the same dir. Default apps/api/.cache/resolver-names.json (gitignored). Empty: memory only.
# RESOLVER_CACHE_FILE=

# --- Voice ---------------------------------------------------------------------------------------------------------------
# Server-side voice, so push-to-talk works in any Chromium browser (Brave and Arc have no browser speech recognition).
# Keys stay on this server: never sent to the extension, never logged. Placeholder values count as unset.
# Deepgram (https://console.deepgram.com) transcribes AND, by default, speaks: one key for both.
DEEPGRAM_API_KEY=
# nova-3: Deepgram's current general model, with keyterm prompting for our five companies and tickers.
DEEPGRAM_MODEL=nova-3
# Silence (ms) after which Deepgram finalises a segment mid-speech. Releasing the key sends Finalize regardless.
DEEPGRAM_ENDPOINTING_MS=100
# The voice for replies; its prefix picks the endpoint. flux-* voices use Flux TTS (POST /v2/speak, mp3, streamed);
# aura-* voices use Aura-2 (POST /v1/speak). Default flux-sienna-en: clear, professional, calm, warm.
DEEPGRAM_TTS_VOICE=flux-sienna-en
# Tried when that voice answers 401/402/429, times out before its first byte (4s) or can't be reached; then Fish.
# Empty: no second Deepgram voice.
DEEPGRAM_TTS_FALLBACK_VOICE=aura-2-athena-en
# Which speech provider goes first: deepgram (default) or fish. The others, if their keys are set, catch failures.
VOICE_TTS=deepgram
# How long an unused warm Deepgram streaming connection stays open (ms). The panel keeps it warm while it is open.
VOICE_WARM_IDLE_MS=60000
# Fish Audio (https://fish.audio): optional. Its API credit is separate from its app credit (402 otherwise).
FISH_API_KEY=
FISH_VOICE_ID=790560d72d4d455ba0464995cd534f27
FISH_MODEL=s2.1-pro
# low | normal | balanced
FISH_LATENCY=balanced
# Claude turns the transcript into an intent (uses ANTHROPIC_API_KEY above). Without it a strict rules parser serves.
# Either way the result is validated: catalog symbols only, and only amounts the user actually said.
INTENT_MODEL=claude-haiku-4-5
# Testing only (refused in production): simulate transcription and speech to exercise the whole path without keys.
# VOICE_PROVIDERS=fake
# VOICE_FAKE_TRANSCRIPT=what's Tesla at

# --- HTTP --------------------------------------------------------------------------------------------------------------
PORT=8790
# development allows http://localhost:* origins; production allows only CORS_ORIGINS.
NODE_ENV=development
# Comma separated, e.g. chrome-extension://abcdefghijklmnopabcdefghijklmnop,https://glance-console.vercel.app
# The deployed console's origin must be here, or its reads fail.
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=120
TRADE_RATE_LIMIT_PER_MINUTE=10
# Only set true behind a proxy you control, or clients can spoof their IP for rate limiting.
TRUST_PROXY=false
# How far back /vault/:address/activity scans (blocks are ~0.17s; 2,000,000 is about 4 days).
ACTIVITY_LOOKBACK_BLOCKS=2000000

# --- Refusals ----------------------------------------------------------------------------------------------------------
# Trades a guard refused before anything was sent (a vault emits no event for them), recorded as JSON lines so the
# console's activity page can show them next to the trades. Default data/refusals.jsonl (gitignored); empty keeps them
# in memory only.
# REFUSAL_LOG_FILE=data/refusals.jsonl

# --- Why it moved --------------------------------------------------------------------------------------------------------
# Company news for GET /why/:symbol (finnhub.io, free tier is enough). Server-side only: never logged, never sent to a client.
# FINNHUB_API_KEY=
# The summary's Claude model (Haiku by default; Opus refused unless ALLOW_OPUS=1). It counts against LLM_BUDGET_WHY.
# WHY_MODEL=claude-haiku-4-5
# Per-IP limits.
# WHY_RATE_LIMIT_PER_MINUTE=20
# PORTFOLIO_RATE_LIMIT_PER_MINUTE=60

# --- Price charts (GET /chart/:symbol) --------------------------------------------------------------------------------
# Robinhood Chain mainnet, read-only: the Chainlink feeds each stand-in mirrors (rounds are cached in .cache).
# RPC_MAINNET_URL=https://rpc.mainnet.chain.robinhood.com
# CHART_RATE_LIMIT_PER_MINUTE=60
