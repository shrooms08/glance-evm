{
  "name": "extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Glance browser extension: an orb that finds companies on the page and buys through your vault.",
  "scripts": {
    "dev": "wxt",
    "dev:brave": "wxt --browser brave",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@glance/core": "workspace:*",
    "@glance/design": "workspace:*",
    "liquid-gooey": "^0.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "thinking-orbs": "0.3.2",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wxt": "0.21.4"
  }
}
