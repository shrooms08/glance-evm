# Feed keeper. Copy to apps/keeper/.env for `pnpm --filter keeper once|watch` (make keeper uses the root .env instead).
# All three are required: the keeper stops with a clear message if one is missing.

# Owner of the TestPriceFeed stand-ins (the deployer key unless ownership was handed over). DISPOSABLE TESTNET KEY ONLY.
KEEPER_PRIVATE_KEY=
TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Seconds between passes in --watch mode (min 15).
KEEPER_INTERVAL_SECONDS=120
# Set to 1 to pause (same as creating keeper.paused at the repo root).
KEEPER_PAUSED=
