# Glance console. Copy to apps/console/.env.local; `pnpm --filter console dev` loads it. Every variable is optional
# locally: the defaults point at a Glance API on localhost and the public testnet RPC.

# The Glance API the console reads from (vault state, activity, prices). Locally: `pnpm --filter api dev`.
# Deployed: a public HTTPS URL, and add the console's origin to the API's CORS_ORIGINS.
NEXT_PUBLIC_GLANCE_API_URL=http://localhost:8790

# Robinhood Chain testnet JSON-RPC, tried first (a dedicated endpoint such as your QuickNode URL is steadier). Used
# for reads the console makes itself (owner checks, your vault, balances) and for waiting on your transactions.
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Comma-separated endpoints tried in order when NEXT_PUBLIC_RPC_URL fails, like the API's RPC_FALLBACK_URLS.
# Defaults to the public RPC.
# NEXT_PUBLIC_RPC_FALLBACK_URLS=https://rpc.testnet.chain.robinhood.com

NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com

# WalletConnect Cloud project id (https://cloud.reown.com). Optional: without it, browser wallets (MetaMask, Rabby,
# Brave Wallet, Coinbase Wallet extension) still work; with it, phone wallets can connect by QR code too.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Where the install page's "Download Glance" points (a zip of the built extension). Empty: the page says how to build it.
NEXT_PUBLIC_EXTENSION_DOWNLOAD_URL=
