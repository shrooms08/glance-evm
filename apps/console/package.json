{
  "name": "console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Glance console: a vault owner sees and controls their vault. Reads from the Glance API, writes only through the owner's own wallet.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run"
  },
  "dependencies": {
    "@glance/core": "workspace:*",
    "@glance/design": "workspace:*",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "^5.103.2",
    "next": "16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.56.8",
    "wagmi": "^2.19.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^30.1.1",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
