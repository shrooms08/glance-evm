# Copy to .env and fill in. Never commit .env. Every make target reads this file.

# Deployer key (testnet only). It becomes the owner of the demo vault, the StockDesk and all stand-in contracts.
PRIVATE_KEY=

# Agent hot key to authorise on the demo vault (address only; the backend holds the key). Optional.
AGENT_ADDRESS=
# Agent key lifetime in days (the vault caps it at 30).
AGENT_TTL_DAYS=29

# Optional overrides. Leave empty to use the defaults documented in docs/CHAIN_NOTES.md.
# USDG_ADDRESS=              # use an existing USDG instead of deploying the TestUSDG stand-in
# SEQUENCER_UPTIME_FEED=     # Chainlink L2 sequencer uptime feed; none exists on either testnet today
# PRICE_NFLX=10000000000     # 8-decimal USD price for NFLX (no Chainlink feed exists to read it from)
# DESK_USDG_TARGET=250000000000
# DESK_STOCK_TARGET=1000000000000000000000

# make seed
# DEMO_RECIPIENT=            # address that receives demo TestUSDG
# DEMO_USDG_AMOUNT=1000000000
# VAULT_DEPOSIT=1000000000

# RPC overrides (public endpoints are used by default)
# ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
# ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
# RH_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com

# Only needed if you verify on Arbiscan instead of Blockscout.
# ARBISCAN_API_KEY=
