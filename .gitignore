# Foundry
cache/
out/
broadcast/

# Secrets
.env
.env.*
!.env.example

# OS
.DS_Store

# Local and dry-run deployment records (real testnet records in deployments/ are committed)
deployments/31337.json
deployments/*.dry-run.json
# Written by the deploy scripts, merged into the record by script/deploy.sh / deploy-etf-standins.sh, then removed
deployments/*.deploy-output.json
deployments/*.etf-standins.json

# Node workspace
node_modules/
apps/*/dist/
*.tsbuildinfo
coverage/

# Extension build output (rebuild with `pnpm --filter extension build`)
apps/extension/.output/
# The end-to-end check's own builds and results (pnpm --filter extension e2e)
apps/extension/.output-e2e/
apps/extension/test-results/
apps/extension/playwright-report/
apps/extension/.wxt/
apps/extension/e2e/out/

# Refused trades the API recorded (REFUSAL_LOG_FILE)
apps/api/data/

# Console build output
apps/console/.next/
apps/console/.next-e2e/
apps/console/.vercel/
# Agent notes that `next dev` writes and re-creates on every run
apps/console/AGENTS.md
apps/console/CLAUDE.md

# The API's resolver cache and Claude call counter (RESOLVER_CACHE_FILE)
apps/api/.cache/

# Private keys (the extension signing key lives outside the repo: ~/.glance-extension-key.pem)
*.pem
